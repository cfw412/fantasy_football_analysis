# Copy this to espn_credentials.env and fill it in. That file is gitignored.
#
#   cp espn_credentials.env.example espn_credentials.env
#
# Both values come from your espn.com cookies while logged in:
# DevTools > Application > Cookies > https://www.espn.com
#
# Environment variables of the same names override this file.
# Nothing here is ever written into the published dashboard.

ESPN_LEAGUE_ID=

# Keep the curly braces.
ESPN_SWID={00000000-0000-0000-0000-000000000000}

# One long url-encoded string. No quotes, no line breaks.
ESPN_S2=
